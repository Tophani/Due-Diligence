# Copy this file to .env and fill in your own values. Never commit .env.

# "production" on the real server (serves the built app, secure cookies). Leave as development locally.
NODE_ENV=development

# postgres://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgres://postgres:your-password@localhost:5432/tractrac
PORT=4000

# Where uploaded files are kept. Must NOT be inside client/dist. Back this folder up.
UPLOAD_DIR=./uploads

# A long random string that signs sign-in cookies and protects sign-in codes. Make one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# The portal's public address (used for links in emails), e.g. https://dd.tractrac.example
APP_URL=http://localhost:5173

# Email (SMTP). Leave SMTP_HOST empty to print emails in the terminal instead.
# Port 587 (STARTTLS) or 465 (TLS). MAIL_FROM is the sender shown to people.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Due Diligence Portal <no-reply@example.com>"

# The due diligence cycle created by "npm run db:fresh" (dates as YYYY-MM-DD, in this order).
# FIRST_SUBMISSION: after this date, organisations with no documents show as "No documents yet".
CYCLE_NAME=2027 Partner Due Diligence
CYCLE_OPENS=2027-01-05
CYCLE_FIRST_SUBMISSION=2027-02-05
CYCLE_DEADLINE=2027-03-31
